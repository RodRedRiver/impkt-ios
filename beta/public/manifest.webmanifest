{
  "id": "/",
  "name": "IMPKT — Boxing Performance",
  "short_name": "IMPKT",
  "description": "Record BOXING-01 training sessions and review punch performance, power, and fatigue.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0B0C10",
  "theme_color": "#0B0C10",
  "categories": ["sports", "fitness", "health"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/favicon.png",
      "sizes": "64x64",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-train.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "IMPKT training screen on mobile"
    },
    {
      "src": "/screenshots/desktop-train.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "IMPKT training screen on desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Start training",
      "short_name": "Train",
      "description": "Open the IMPKT training screen",
      "url": "/",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Session history",
      "short_name": "History",
      "description": "Review saved boxing sessions",
      "url": "/history",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
