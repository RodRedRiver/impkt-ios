<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- How the archive becomes an ipa. TEAM_ID_HERE is substituted by the workflow
     from a secret, so the team id is not committed. Automatic signing means the
     runner asks Apple for the certificate and profile it needs, which is the
     whole reason this pipeline has no certificates to manage or rotate. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>TEAM_ID_HERE</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
