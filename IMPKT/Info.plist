<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keys every app bundle must have. Xcode does not add them to a custom
	     Info.plist, and without CFBundleIdentifier an archive fails late with
	     "Archive Missing Bundle Identifier" rather than at compile time. Each one
	     reads a build setting, so project.yml stays the single place a value is
	     written. -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- What the home screen says. Matches the App Store listing, "Impkt Band",
	     rather than the target name, which is IMPKT and stays that way because
	     renaming a target renames the scheme the CI workflow builds. -->
	<key>CFBundleDisplayName</key>
	<string>Impkt Band</string>
	<!-- Names the icon set in Assets.xcassets. Xcode injects this into a generated
	     Info.plist but not into one of ours, and App Store validation refuses an
	     upload without it, after the build has otherwise succeeded. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- Both from build settings on purpose. The workflow passes
	     CURRENT_PROJECT_VERSION=<run number>, and a hardcoded 1 here would
	     silently ignore it, so every upload after the first would be refused as
	     a repeat build number. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Answers the export compliance question up front, which otherwise holds
	     every TestFlight build behind a "Missing Compliance" prompt in the web
	     interface. False is the truthful answer: the app implements no encryption
	     of its own, and Bluetooth's own link security is the operating system's. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- The page has one appearance and it is light: a white product photographed on
	     a light grey ground, with no dark variant of any of it. The native tabs are
	     painted that same grey so the seam between them and the page does not show,
	     which only works in one appearance. Left to follow the system, dark mode
	     bolted a dark tab bar to a light page and put dark mode's own white labels on
	     top of a #f5f5f7 bar, where they cannot be read. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Both strings, and both honest. Apple rejects a build whose Bluetooth
	     reason is vague, and a pilot reading it deserves to know the radio is
	     for the wraps and nothing else. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>IMPKT connects to your wraps to record punches and to install firmware updates on them. Nothing is sent anywhere else.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>IMPKT connects to your wraps to record punches and to install firmware updates on them.</string>
</dict>
</plist>
